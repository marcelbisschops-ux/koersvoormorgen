#!/bin/bash
# ══════════════════════════════════════════════════════════════════
# KantoorInzicht — rem vóór elke push naar GitHub
#
# Draait bij elke "git push" (terminal én GitHub Desktop, beide gebruiken
# deze git-hooks) automatisch de statische veiligheidsaudit en de
# UI-testsuite. Faalt een van de twee, dan wordt de push geweigerd.
#
# Dit is het frontend-equivalent van scripts/deploy-worker.sh (die dekt de
# worker-deploy; deze hook dekt mna.html/adv.html/marilyn.html-pushes).
#
# Noodgeval (bewust overslaan): git push --no-verify
# ══════════════════════════════════════════════════════════════════
set -euo pipefail
REPO_DIR="$(git rev-parse --show-toplevel)"
cd "$REPO_DIR"

echo "── Rem vóór push: veiligheidsaudit + UI-testsuite ──"

if ! node tests/audit-consistentie.mjs; then
  echo "" >&2
  echo "✗ Veiligheidsaudit heeft bevindingen — push geweigerd. Zie hierboven." >&2
  echo "  Noodgeval? git push --no-verify (alleen met expliciete reden)." >&2
  exit 1
fi

if [ -z "${ADMIN_KEY:-}" ]; then
  echo "⚠ Geen ADMIN_KEY in environment — module-gating-test wordt overgeslagen, rest draait gewoon."
fi

if ! npx playwright test; then
  echo "" >&2
  echo "✗ UI-testsuite gefaald — push geweigerd. Zie hierboven." >&2
  echo "  Noodgeval? git push --no-verify (alleen met expliciete reden)." >&2
  exit 1
fi

echo "✓ Audit en testsuite groen — push gaat door."

# Best-effort melding aan het veiligheidsdashboard (marilyn.html → Veiligheid) dat de statische
# audit hier zojuist groen was — blokkeert de push nooit, faalt stil zonder ADMIN_KEY (20 aug 2026).
# 12-11-2026 (ISO-bewijs): kwam sinds de sleutelrotatie van 19 sep niet meer aan; nu eerst de sleutelhanger.
MELD_SLEUTEL=$(/usr/bin/security find-generic-password -a "$(id -un)" -s kantoorinzicht-production-admin-key -w 2>/dev/null || true)
[ -z "$MELD_SLEUTEL" ] && MELD_SLEUTEL="${ADMIN_KEY:-}"
if [ -n "$MELD_SLEUTEL" ]; then
  MELD_STATUS=$(curl -s -o /dev/null -w '%{http_code}' -m 5 -X POST -H "Content-Type: application/json" -H "x-admin-key: ${MELD_SLEUTEL}" \
    "https://kantoorinzicht.marcel-bisschops.workers.dev/mna/admin/veiligheid/statische-audit" \
    -d '{"repo":"frontend","checks_totaal":11,"checks_geslaagd":11}' 2>/dev/null || echo 000)
  [ "$MELD_STATUS" = "200" ] && echo "✓ Veiligheidsdashboard bijgewerkt (frontend)." || echo "  ⚠ Dashboard-melding mislukt (HTTP $MELD_STATUS), niet blokkerend."
else
  echo "  ⚠ Geen beheersleutel — veiligheidsdashboard niet bijgewerkt."
fi
unset MELD_SLEUTEL MELD_STATUS
